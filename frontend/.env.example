VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional Map Provider Keys (Standard OpenStreetMap & Esri World Imagery work out-of-the-box without keys)
# VITE_MAPTILER_KEY=your_maptiler_api_key_here
# VITE_MAPBOX_TOKEN=your_mapbox_access_token_here
# CARTO key for the Voyager basemap; restrict its allowed websites in CARTO.
# VITE_CARTO_API_KEY=your_carto_api_key_here
# VITE_TERRAIN_DEM_URL=https://api.maptiler.com/tiles/terrain-rgb/{z}/{x}/{y}.png?key=YOUR_KEY
