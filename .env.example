# AgriShift Environment Configuration Template
# Copy this file to .env for local development. Never commit real secrets.

# Frontend API Base URL (Optional - frontend runs standalone with local fixtures by default)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL Local Container Settings (for docker-compose.yml)
POSTGRES_USER=agrishift
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=agrishift_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agrishift:replace-with-local-password@localhost:5432/agrishift_db
